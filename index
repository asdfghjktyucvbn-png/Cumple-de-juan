<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Feliz Cumpleaños ♡♡♡</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
        }

        body {
            min-height: 100vh;
            background: radial-gradient(ellipse at center, #0a0a1a 0%, #000000 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Poppins', 'Segoe UI', system-ui, sans-serif;
            overflow: hidden;
            position: relative;
            cursor: pointer;
        }

        /* Estrellas animadas */
        .star {
            position: absolute;
            background-color: white;
            border-radius: 50%;
            box-shadow: 0 0 6px rgba(255, 255, 255, 0.9), 0 0 2px rgba(255, 255, 200, 0.8);
            animation: twinkle 2s infinite alternate ease-in-out;
            pointer-events: none;
            z-index: 1;
        }

        @keyframes twinkle {
            0% {
                opacity: 0.2;
                transform: scale(0.7);
            }
            100% {
                opacity: 1;
                transform: scale(1.3);
            }
        }

        /* Contenedor principal */
        .center-content {
            position: relative;
            z-index: 20;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100%;
            pointer-events: auto;
        }

        /* Regalo: el contenedor maneja hover, la imagen tiene latido */
        .gift-box {
            cursor: pointer;
            display: inline-block;
            filter: drop-shadow(0 0 12px rgba(255, 215, 0, 0.6));
            transition: filter 0.3s ease, transform 0.15s ease;
            max-width: 320px;
            width: 70%;
            will-change: filter;
        }

        .gift-box:hover {
            filter: drop-shadow(0 0 22px rgba(255, 100, 100, 0.8));
            transform: scale(1.03);
        }

        /* La imagen del regalo palpita */
        .gift-box img {
            width: 100%;
            height: auto;
            display: block;
            pointer-events: none;
            border-radius: 20px;
            animation: heartbeat 1.1s ease-in-out infinite;
            will-change: transform;
        }

        @keyframes heartbeat {
            0% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.07);
            }
            100% {
                transform: scale(1);
            }
        }

        /* Desaparición del regalo */
        .gift-hidden {
            animation: giftDisappear 0.5s cubic-bezier(0.34, 1.2, 0.64, 1) forwards !important;
            pointer-events: none;
        }

        @keyframes giftDisappear {
            0% {
                transform: scale(1) rotate(0deg);
                opacity: 1;
            }
            40% {
                transform: scale(1.15) rotate(3deg);
                filter: blur(2px);
            }
            100% {
                transform: scale(0) rotate(10deg);
                opacity: 0;
                visibility: hidden;
            }
        }

        /* Mensaje de cumpleaños */
        .birthday-message {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #FFFFFF;
            font-size: clamp(1.8rem, 9vw, 4.5rem);
            font-weight: 900;
            text-align: center;
            z-index: 200;
            opacity: 0;
            pointer-events: none;
            animation: messageGlowRise 0.7s cubic-bezier(0.2, 0.9, 0.4, 1.1) forwards;
            letter-spacing: 2px;
            max-width: 90vw;
            white-space: normal;
            word-break: break-word;
            padding: 0.8rem 1.8rem;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(10px);
            border-radius: 80px;
            font-family: 'Poppins', 'Montserrat', sans-serif;
            text-shadow:
                0 0 10px rgba(255, 215, 0, 0.8),
                0 0 20px rgba(255, 200, 0, 0.6),
                2px 2px 0px #B8860B,
                -1px -1px 0px #DAA520,
                1px 1px 0px #FFD700;
            border: 2px solid rgba(255, 215, 0, 0.5);
            box-shadow: 0 0 40px rgba(255, 200, 0, 0.3), inset 0 0 20px rgba(255, 215, 0, 0.2);
            line-height: 1.3;
        }

        @keyframes messageGlowRise {
            0% {
                opacity: 0;
                transform: translate(-50%, -50%) scale(0.3);
                filter: blur(12px);
            }
            40% {
                opacity: 1;
                transform: translate(-50%, -50%) scale(1.05);
            }
            100% {
                opacity: 1;
                transform: translate(-50%, -50%) scale(1);
                filter: blur(0);
            }
        }

        /* Canvas para fuegos artificiales */
        #fireworks-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 100;
        }

        /* Sugerencia sutil */
        .restart-hint {
            position: fixed;
            bottom: 18px;
            right: 18px;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(5px);
            padding: 6px 14px;
            border-radius: 40px;
            font-size: 12px;
            color: #ffecb3;
            font-family: 'Poppins', sans-serif;
            z-index: 300;
            pointer-events: none;
            opacity: 0.7;
            letter-spacing: 0.5px;
        }

        @media (max-width: 600px) {
            .gift-box {
                max-width: 250px;
                width: 75%;
            }
            .birthday-message {
                font-size: clamp(1.5rem, 7vw, 2.6rem);
                width: 85%;
                padding: 0.6rem 1rem;
                letter-spacing: 1px;
            }
        }
    </style>
</head>
<body>

    <!-- Cielo estrellado -->
    <div id="stars-container"></div>

    <!-- Fuegos artificiales -->
    <canvas id="fireworks-canvas"></canvas>

    <!-- Regalo interactivo -->
    <div class="center-content" id="giftWrapper">
        <div class="gift-box" id="giftBox">
            <!-- IMAGEN CORREGIDA: usa dl.dropboxusercontent.com y sin crossorigin -->
            <img id="giftImage"
                 src="https://dl.dropboxusercontent.com/scl/fi/4ihx6grntf602vequrhe4/187ebbb90838346406556c3dbf033ad4-removebg-preview.png?rlkey=9cke99kl2neh4zojyi46vl4k6&dl=1"
                 alt="Regalo de cumpleaños dorado"
                 onerror="this.onerror=null; console.error('Error cargando imagen de Dropbox, usando respaldo'); this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 200 200%22%3E%3Crect width=%22200%22 height=%22200%22 fill=%22%23ffcc00%22/%3E%3Ctext x=%2250%25%22 y=%2250%25%22 font-size=%2240%22 text-anchor=%22middle%22 fill=%22%23b35900%22 dy=%22.3em%22%3E🎁%3C/text%3E%3C/svg%3E';">
        </div>
    </div>

    <div class="restart-hint"> Toca el regalo :D</div>

    <script>
        (function() {
            // ---------- 1. ESTRELLAS ----------
            const starsContainer = document.getElementById('stars-container');
            const STAR_COUNT = 200;

            function createStars() {
                starsContainer.innerHTML = '';
                const fragment = document.createDocumentFragment();
                for (let i = 0; i < STAR_COUNT; i++) {
                    const star = document.createElement('div');
                    star.classList.add('star');
                    const size = Math.random() * 3.5 + 1;
                    star.style.width = `${size}px`;
                    star.style.height = `${size}px`;
                    star.style.left = `${Math.random() * 100}%`;
                    star.style.top = `${Math.random() * 100}%`;
                    star.style.animationDuration = `${Math.random() * 2.5 + 1}s`;
                    star.style.animationDelay = `${Math.random() * 4}s`;
                    fragment.appendChild(star);
                }
                starsContainer.appendChild(fragment);
            }
            createStars();

            // ---------- 2. MÚSICA DE FONDO (con autoplay mejorado) ----------
            let audio = null;

            function initAudio() {
                if (audio) return;
                audio = new Audio('https://www.dropbox.com/scl/fi/u6s2nstod049yw0d7xjhz/I-Can-t-Wait.mp3?rlkey=w2c7mm648gddzpdrcj1no3wmz&st=m2oakhkj&dl=1');
                audio.loop = true;
                audio.volume = 0.65;
                audio.preload = 'auto';
                
                // Intento inmediato de autoplay
                audio.play().then(() => {
                    console.log('✅ Música iniciada automáticamente');
                }).catch(() => {
                    console.log('⏳ Autoplay bloqueado, esperando interacción del usuario');
                });
            }
            initAudio();

            function playMusic() {
                if (!audio) initAudio();
                if (audio && audio.paused) {
                    audio.play().catch(() => {});
                }
            }

            // ---------- 3. FUEGOS ARTIFICIALES INFINITOS ----------
            const canvas = document.getElementById('fireworks-canvas');
            const ctx = canvas.getContext('2d');
            let particles = [];
            let animationId = null;
            let fireworksActive = false;
            let fireworkInterval = null;
            const MAX_PARTICLES = 500;

            function resizeCanvas() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resizeCanvas);
            resizeCanvas();

            class FireParticle {
                constructor(x, y, vx, vy, color, size, gravity = 0.18, life = 1.0) {
                    this.x = x;
                    this.y = y;
                    this.vx = vx;
                    this.vy = vy;
                    this.color = color;
                    this.size = size;
                    this.alpha = 1.0;
                    this.gravity = gravity;
                    this.life = life;
                    this.decay = 0.018 + Math.random() * 0.025;
                    this.drag = 0.98;
                }

                update() {
                    this.vx *= this.drag;
                    this.vy *= this.drag;
                    this.x += this.vx;
                    this.y += this.vy;
                    this.vy += this.gravity;
                    this.life -= this.decay;
                    this.alpha = Math.min(1, this.life * 1.3);
                    return this.life > 0.02;
                }

                draw(ctx) {
                    ctx.save();
                    ctx.globalAlpha = this.alpha * 0.95;
                    ctx.shadowBlur = 12;
                    ctx.shadowColor = this.color;
                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                    ctx.fillStyle = this.color;
                    ctx.fill();
                    if (this.size > 2.5) {
                        ctx.globalAlpha = this.alpha * 0.5;
                        ctx.beginPath();
                        ctx.arc(this.x, this.y, this.size * 0.6, 0, Math.PI * 2);
                        ctx.fillStyle = '#FFF9C4';
                        ctx.fill();
                    }
                    ctx.restore();
                }
            }

            function createExplosion(x, y, intensity = 1.0) {
                if (particles.length > MAX_PARTICLES) return;

                const count = Math.floor(55 + Math.random() * 45 * intensity);
                const colorPalette = ['#FF2A6D', '#FFD166', '#06FFA5', '#FFB347', '#F72585', '#4CC9F0', '#FF9F1C', '#E63946', '#9C27B0', '#00E5FF'];
                const mainColors = Array.from({ length: 4 }, () => colorPalette[Math.floor(Math.random() * colorPalette.length)]);

                for (let i = 0; i < count; i++) {
                    const angle = Math.random() * Math.PI * 2;
                    const speed = Math.random() * 7.5 + 3.5;
                    const vx = Math.cos(angle) * speed * (Math.random() * 1.4);
                    const vy = Math.sin(angle) * speed * (Math.random() * 1.4);
                    const col = mainColors[Math.floor(Math.random() * mainColors.length)];
                    const size = Math.random() * 5 + 2.2;
                    const gravity = 0.12 + Math.random() * 0.18;
                    const life = 0.9 + Math.random() * 0.7;
                    particles.push(new FireParticle(x, y, vx, vy, col, size, gravity, life));
                }

                for (let i = 0; i < 20; i++) {
                    const angle = Math.random() * Math.PI * 2;
                    const speed = Math.random() * 9 + 2;
                    const vx = Math.cos(angle) * speed * 0.9;
                    const vy = Math.sin(angle) * speed * 0.9;
                    particles.push(new FireParticle(x, y, vx, vy, '#FFE484', Math.random() * 3 + 1.8, 0.08, 0.7));
                }
            }

            function rapidFireworksRound() {
                if (!fireworksActive) return;
                const w = canvas.width;
                const h = canvas.height;
                const explosionsCount = 5 + Math.floor(Math.random() * 5);
                for (let i = 0; i < explosionsCount; i++) {
                    const randX = Math.random() * w;
                    const randY = Math.random() * h * 0.75 + 50;
                    const intensity = 0.8 + Math.random() * 0.7;
                    setTimeout(() => {
                        if (fireworksActive) createExplosion(randX, randY, intensity);
                    }, i * 60);
                }
            }

            function startFireworks() {
                if (fireworksActive) return;
                fireworksActive = true;
                particles = [];

                // Ráfaga inicial
                createExplosion(canvas.width / 2, canvas.height / 2.5, 1.2);
                setTimeout(() => createExplosion(canvas.width * 0.2, canvas.height * 0.4, 0.9), 80);
                setTimeout(() => createExplosion(canvas.width * 0.8, canvas.height * 0.4, 0.9), 120);
                setTimeout(() => createExplosion(canvas.width * 0.5, canvas.height * 0.6, 1.0), 200);

                if (fireworkInterval) clearInterval(fireworkInterval);
                fireworkInterval = setInterval(() => {
                    if (!fireworksActive) {
                        clearInterval(fireworkInterval);
                        fireworkInterval = null;
                        return;
                    }
                    rapidFireworksRound();
                }, 550);

                // ✅ FUEGOS ARTIFICIALES INFINITOS: no se detienen nunca
                console.log('🎆 Fuegos artificiales infinitos activados');
            }

            function drawFrame() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                let anyAlive = false;
                for (let i = 0; i < particles.length; i++) {
                    const alive = particles[i].update();
                    if (alive) {
                        anyAlive = true;
                        particles[i].draw(ctx);
                    } else {
                        particles.splice(i, 1);
                        i--;
                    }
                }
                if (anyAlive || fireworksActive) {
                    animationId = requestAnimationFrame(drawFrame);
                } else {
                    if (animationId) {
                        cancelAnimationFrame(animationId);
                        animationId = null;
                    }
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                }
            }

            function startParticleEngine() {
                if (!animationId) drawFrame();
            }

            // ---------- 4. MENSAJE PERMANENTE ----------
            let messageDiv = null;
            let isMessageDisplayed = false;

            function showBirthdayMessage() {
                if (isMessageDisplayed || messageDiv) return;
                messageDiv = document.createElement('div');
                messageDiv.className = 'birthday-message';
                messageDiv.textContent = '♡ Feliz Cumpleaños al cumpleañero más increíble :D ♡';
                document.body.appendChild(messageDiv);
                isMessageDisplayed = true;
            }

            // ---------- 5. LÓGICA DE APERTURA DEL REGALO ----------
            const giftBoxElem = document.getElementById('giftBox');
            let isGiftOpened = false;

            function openGiftAndCelebrate(event) {
                if (isGiftOpened) return;
                isGiftOpened = true;

                playMusic();

                giftBoxElem.classList.add('gift-hidden');
                setTimeout(() => {
                    const wrapper = document.getElementById('giftWrapper');
                    if (wrapper) wrapper.style.display = 'none';
                }, 480);

                showBirthdayMessage();
                startFireworks();
                startParticleEngine();

                if (navigator.vibrate) navigator.vibrate(80);
            }

            giftBoxElem.addEventListener('click', (e) => {
                e.stopPropagation();
                openGiftAndCelebrate(e);
            });

            giftBoxElem.addEventListener('touchstart', (e) => {
                e.preventDefault();
                openGiftAndCelebrate(e);
            }, { passive: false });

            window.addEventListener('resize', () => {
                if (animationId && particles.length > 0) drawFrame();
            });

            // Verificar si la imagen cargó correctamente
            const giftImg = document.getElementById('giftImage');
            giftImg.addEventListener('load', () => {
                console.log('✅ Imagen del regalo cargada correctamente');
            });
            giftImg.addEventListener('error', () => {
                console.error('❌ Error: La imagen del regalo no pudo cargarse');
            });

            console.log('🎂 Página lista: toca el regalo para celebrar');
        })();
    </script>
</body>
</html>
